---
// /v2: the "navy edition" of the homepage, in the logo's colours (navy, green, yellow) with its own layout for the
// hero, problem, solution, plans and testimonials. Shared sections (team, how it works, projects, FAQ,
// booking) follow the theme tokens; components switch colours, illustrations and same-page links from the URL
// (see src/lib/theme.ts).
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/v2/Hero.astro';
import Problem from '../components/v2/Problem.astro';
import Solution from '../components/v2/Solution.astro';
import Team from '../components/Team.astro';
import Offers from '../components/v2/Offers.astro';
import Testimonial from '../components/Testimonial.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Projects from '../components/Projects.astro';
import FAQ from '../components/FAQ.astro';
import BookCall from '../components/BookCall.astro';
import Footer from '../components/Footer.astro';
---

<Base>
  <Header dark />
  <main id="main-content">
    <Hero />
    <Problem />
    <Solution />
    <Team />
    <Offers />
    <Testimonial dark />
    <HowItWorks />
    <Projects />
    <FAQ />
    <BookCall />
  </main>
  <Footer />
</Base>
