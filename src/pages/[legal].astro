---
// Legal pages: /terms and /privacy, from src/content/legal.
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';

export async function getStaticPaths() {
  const pages = (await getCollection('legal')).sort((a, b) => a.data.order - b.data.order);
  return pages.map((page) => ({ params: { legal: page.id }, props: { page, pages } }));
}

interface Props {
  page: CollectionEntry<'legal'>;
  pages: CollectionEntry<'legal'>[];
}

const { page, pages } = Astro.props;
const { title, description, summary, updated, note } = page.data;
const { Content, headings } = await render(page);
const toc = headings.filter((h) => h.depth === 2);
const updatedLabel = updated.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
// The "have a lawyer check this" note is for the client, so it only shows locally and on review builds.
const showNote = note && (import.meta.env.DEV || import.meta.env.PUBLIC_REVIEW_BUILD === 'true');
const url = new URL(`/${page.id}/`, site.url).href;
const contactEmail = 'contact@ghlmegaminds.com';

const schema = [
  {
    '@type': 'WebPage',
    '@id': `${url}#page`,
    name: title,
    description,
    url,
    dateModified: updated.toISOString().slice(0, 10),
    isPartOf: { '@id': `${site.url}/#website` },
  },
];
---

<Base title={`${title} | GHL Megaminds`} description={description} schema={schema}>
  <Header />
  <main id="main-content">
    <header class="container-x pb-10 pt-12 sm:pt-16 lg:pb-14 lg:pt-20">
      <div class="mx-auto max-w-[52rem] text-center" data-stagger>
        <Eyebrow icon="scales-fill" class="hero-in">Legal</Eyebrow>
        <h1 class="mt-6 text-[clamp(2.6rem,5.4vw,4.2rem)] font-extrabold leading-[1.02] tracking-[-0.045em]">{title}</h1>
        <p class="mx-auto mt-5 max-w-[38rem] text-lg leading-relaxed text-ink-soft sm:text-xl">{summary}</p>
        <p class="mt-5 inline-flex items-center gap-2 text-[14px] text-ink-soft">
          <Icon name="calendar-blank" class="size-4" />
          Last updated <time datetime={updated.toISOString().slice(0, 10)} class="font-semibold text-ink">{updatedLabel}</time>
        </p>

        <!-- Switch between the legal pages -->
        <nav aria-label="Legal pages" class="mt-8 flex justify-center">
          <ul class="inline-flex gap-1 rounded-full bg-paper p-1 ring-1 ring-ink/[0.08]">
            {
              pages.map((p) => (
                <li>
                  <a
                    href={`/${p.id}/`}
                    aria-current={p.id === page.id ? 'page' : undefined}
                    class="block rounded-full px-4 py-2 text-[14px] font-semibold text-ink-soft transition hover:text-ink aria-[current=page]:bg-ink aria-[current=page]:text-canvas"
                  >
                    {p.data.title}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <div class="container-x border-t border-ink/10 pb-24 pt-12 lg:pb-32 lg:pt-16">
      <div class="mx-auto grid max-w-[68rem] gap-10 lg:grid-cols-12 lg:gap-12">
        <aside class="lg:col-span-4 xl:col-span-3">
          <div class="lg:sticky lg:top-28">
            <nav aria-label="On this page" data-toc>
              <details class="toc rounded-inner bg-paper p-5 ring-1 ring-ink/[0.08] lg:bg-transparent lg:p-0 lg:ring-0" open>
                <summary class="flex cursor-pointer items-center justify-between text-[13px] font-bold uppercase tracking-[0.08em] text-ink-soft lg:pointer-events-none">
                  On this page
                  <Icon name="caret-down" class="size-4 transition-transform lg:hidden" />
                </summary>
                <ol class="mt-4 grid gap-1 border-l border-ink/10 text-[14.5px] leading-snug">
                  {
                    toc.map((h) => (
                      <li>
                        <a href={`#${h.slug}`} class="-ml-px block border-l-2 border-transparent py-1.5 pl-4 text-ink-soft transition hover:text-ink aria-[current=true]:border-sun aria-[current=true]:font-semibold aria-[current=true]:text-ink">
                          {h.text.replace(/^\d+\.\s*/, '')}
                        </a>
                      </li>
                    ))
                  }
                </ol>
              </details>
            </nav>

            <div class="mt-8 hidden rounded-card bg-paper p-6 ring-1 ring-ink/[0.08] lg:block">
              <p class="font-display text-lg font-bold tracking-[-0.02em]">Questions?</p>
              <p class="mt-1.5 text-[14.5px] leading-relaxed text-ink-soft">We answer every email, usually within a working day.</p>
              <a href={`mailto:${contactEmail}`} class="mt-3 inline-flex items-center gap-1.5 text-[14.5px] font-semibold text-forest underline decoration-forest/35 underline-offset-4 hover:decoration-forest">
                <Icon name="envelope-simple" class="size-4" />
                {contactEmail}
              </a>
            </div>
          </div>
        </aside>

        <article class="min-w-0 lg:col-span-8 xl:col-span-9">
          <div class="prose-blog prose-legal max-w-[46rem]">
            <Content />
          </div>

          {
            showNote && (
              <aside class="mt-12 flex max-w-[46rem] gap-3 rounded-inner bg-butter p-5 text-[14.5px] leading-relaxed" aria-label="Before launch">
                <Icon name="warning-circle-fill" class="mt-0.5 size-5 shrink-0 text-gold" />
                <p>
                  <span class="font-bold">Before launch (review builds only): </span>
                  {note}
                </p>
              </aside>
            )
          }
        </article>
      </div>
    </div>
  </main>
  <Footer />
</Base>

<script>
  // "On this page": mark the section being read; on phones the list starts closed.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc] a[href^="#"]')];
  const sections = links
    .map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
    .filter((el): el is HTMLElement => Boolean(el));
  if (sections.length && 'IntersectionObserver' in window) {
    const setCurrent = (id: string) => links.forEach((a) => a.setAttribute('aria-current', String(a.hash.slice(1) === id)));
    const io = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) setCurrent(visible[0].target.id);
      },
      { rootMargin: '-15% 0px -70% 0px' },
    );
    sections.forEach((s) => io.observe(s));
  }
  const toc = document.querySelector<HTMLDetailsElement>('[data-toc] details');
  if (toc && matchMedia('(max-width: 1023px)').matches) toc.open = false;
</script>
