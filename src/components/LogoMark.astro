---
// The GHL Megaminds mark: three dots in HighLevel yellow, blue and green that grow as they climb (small agency to
// big agency). The colours stay the same on light and dark backgrounds. Source of truth: scripts/build-logo.mjs.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg viewBox="0 0 64 64" class={className} aria-hidden="true" focusable="false">
  <circle cx="13" cy="50" r="7" fill="#FFC800"></circle>
  <circle cx="29.5" cy="35" r="9.5" fill="#2896FB"></circle>
  <circle cx="48" cy="17" r="12" fill="#17C94B"></circle>
</svg>
