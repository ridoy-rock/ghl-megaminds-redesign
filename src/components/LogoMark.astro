---
// The GHL Megaminds "Workflow" mark: three steps of an automation (trigger, action, result) in HighLevel yellow, blue
// and green, linked by a rising line. The line uses the current text colour; the dots keep their colours.
// `nested` renders just the shapes, for use inside another SVG (the Logo lockup).
interface Props {
  class?: string;
  nested?: boolean;
}

const { class: className, nested = false } = Astro.props;
---

{
  nested ? (
    <g>
      <path d="M12 50 C22 50 22 32 32 32 S42 14 52 14" fill="none" stroke="currentColor" stroke-width="4.5" stroke-linecap="round" />
      <circle cx="12" cy="50" r="8" fill="#FFC800" />
      <circle cx="32" cy="32" r="8" fill="#2896FB" />
      <circle cx="52" cy="14" r="8" fill="#17C94B" />
    </g>
  ) : (
    <svg viewBox="0 0 64 64" class={className} aria-hidden="true" focusable="false">
      <path d="M12 50 C22 50 22 32 32 32 S42 14 52 14" fill="none" stroke="currentColor" stroke-width="4.5" stroke-linecap="round" />
      <circle cx="12" cy="50" r="8" fill="#FFC800" />
      <circle cx="32" cy="32" r="8" fill="#2896FB" />
      <circle cx="52" cy="14" r="8" fill="#17C94B" />
    </svg>
  )
}
