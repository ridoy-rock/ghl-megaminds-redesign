---
import WorkflowArt from './WorkflowArt.astro';
import Icon from './Icon.astro';
import Eyebrow from './Eyebrow.astro';
import { BOOKING_URL, BOOK_LABEL, heroFacts } from '../data/site';

// Headline words animate in one after another; --w is each word's position in the sequence.
const lineOne = ['Your', 'HighLevel', 'system,'];
const lineTwo = ['implemented', 'by', 'certified'];
const marked = 'engineers';
---

<section id="top" class="relative overflow-hidden">
  <div class="container-x grid items-center gap-8 pb-12 pt-10 sm:pt-14 lg:grid-cols-12 lg:gap-6 lg:pb-16 lg:pt-12">
    <div class="relative z-10 lg:col-span-7">
      <Eyebrow class="hero-in">The HighLevel Engineering Partner</Eyebrow>

      <h1 class="mt-7 max-w-[740px] text-[clamp(2.8rem,5.7vw,4.5rem)] font-extrabold leading-[1.04] tracking-[-0.045em]">
        {
          lineOne.map((word, i) => (
            <>
              <span class="word">
                <span style={`--w: ${i}`}>{word}</span>
              </span>{' '}
            </>
          ))
        }<br />{
          lineTwo.map((word, i) => (
            <>
              <span class="word">
                <span style={`--w: ${i + lineOne.length}`}>{word}</span>
              </span>{' '}
            </>
          ))
        }<span class="marker"><span class="word"><span style={`--w: ${lineOne.length + lineTwo.length}`}>{marked}</span></span></span>
      </h1>

      <p class="hero-in mt-7 max-w-[35rem] text-lg leading-relaxed text-ink-soft sm:text-xl" style="--d: 520">
        We give agencies, SaaS resellers, and B2B providers an engineering team behind the systems they sell,
        implement, and support.
      </p>

      <div class="hero-in mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap" style="--d: 640">
        <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="btn btn-ink">
          {BOOK_LABEL}
          <Icon name="arrow-right" class="btn-arrow size-4" />
        </a>
        <a href="#offers" class="btn btn-ghost">View our services</a>
      </div>
    </div>

    <!-- Art scales in on load, then drifts down and fades a little as the page scrolls away (scroll-drift). -->
    <div class="scroll-drift relative lg:col-span-5">
      <div class="art-in relative mx-auto w-full max-w-[400px] lg:max-w-[440px]">
        <div class="absolute inset-[14%] rounded-full bg-sun/30 blur-3xl" aria-hidden="true"></div>
        <WorkflowArt
          alt="Illustrative CRM workflow connecting new leads to follow-up messages, booked calls and won deals"
          class="float-soft relative w-full"
        />
      </div>
    </div>
  </div>

  <div class="container-x">
    <dl class="grid gap-6 border-t border-ink/10 py-9 sm:grid-cols-3 sm:gap-8">
      {
        heroFacts.map((fact, i) => (
          <div class:list={['flex flex-col gap-2', i > 0 && 'sm:border-l sm:border-ink/10 sm:pl-8']} data-reveal style={`--d: ${i * 80}`}>
            <dt class="order-last max-w-[18rem] text-[15px] leading-snug text-ink-soft">{fact.label}</dt>
            <dd class="font-display text-[1.5rem] font-extrabold leading-tight tracking-[-0.03em] lg:text-[1.8rem]">{fact.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
