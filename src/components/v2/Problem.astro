---
// /v2 problem section: a light, side-by-side comparison. The usual options on a white card (with the tangled-cables
// art), the GHL Megaminds way on a navy card, and a yellow "vs" badge between them.
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import AppIcon from '../AppIcon.astro';
import Eyebrow from '../Eyebrow.astro';
import tangleArt from '../../assets/illustrations/tangle.png';
import { art } from '../../lib/theme';
import { usualOptions, megamindsPoints, PLANS_HREF, PLANS_LABEL } from '../../data/site';
---

<section id="why-us" class="scroll-mt-20 py-24 lg:py-32">
  <div class="container-x">
    <div class="mx-auto max-w-[46rem] text-center" data-stagger>
      <Eyebrow icon="warning-circle-fill">The problem</Eyebrow>
      <h2 class="mt-5 text-[clamp(2.1rem,4.4vw,3.6rem)] font-extrabold leading-[1.02] tracking-[-0.038em]">
        Stop babysitting VAs and wrestling with complex tech.
      </h2>
      <p class="mx-auto mt-6 max-w-[38rem] text-lg leading-relaxed text-ink-soft">
        You started your agency to sign high-ticket clients and grow revenue. Not to spend hours fixing broken
        workflows or micro-managing inexperienced assistants.
      </p>
    </div>

    <div class="relative mt-14 grid gap-5 lg:grid-cols-2 lg:gap-6">
      <div class="rounded-card bg-paper p-7 ring-1 ring-ink/[0.08] sm:p-9" data-reveal="left">
        <div class="flex items-start justify-between gap-6">
          <h3 class="pt-2 text-[1.85rem] font-extrabold leading-[1.08] tracking-[-0.032em]">The usual options</h3>
          <div class="scroll-tilt shrink-0" style="--tilt: 9deg">
            <Image
              src={art(tangleArt, Astro.url)}
              alt="Clay illustration of a tangled knot of cables with a loose plug"
              widths={[160, 240]}
              sizes="112px"
              class="h-auto w-24 sm:w-28"
            />
          </div>
        </div>
        <ul class="mt-6 grid gap-3">
          {
            usualOptions.map((option, i) => (
              <li class="rounded-inner bg-canvas p-5 ring-1 ring-ink/[0.05] sm:p-6" data-reveal style={`--d: ${i * 90}`}>
                <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2">
                  <h4 class="flex items-center gap-2.5 text-[17px] font-bold tracking-[-0.015em]">
                    <Icon name="x-circle-fill" class="size-5 shrink-0 text-ink/25" />
                    {option.title}
                  </h4>
                  <span class="rounded-full bg-stone px-3 py-1 text-xs font-semibold text-ink-soft">{option.tag}</span>
                </div>
                <p class="mt-2 text-[15px] leading-relaxed text-ink-soft">{option.body}</p>
              </li>
            ))
          }
        </ul>
      </div>

      <div
        class="pointer-events-none absolute left-1/2 top-1/2 z-10 hidden size-14 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-sun font-display text-lg font-extrabold text-ink ring-8 ring-canvas lg:grid"
        aria-hidden="true"
      >
        vs
      </div>

      <div class="on-dark flex flex-col rounded-card bg-pine p-7 text-canvas sm:p-9 lg:p-10" data-reveal="right" style="--d: 120">
        <div class="flex items-center gap-3">
          <AppIcon tone="light" class="size-11" />
          <p class="text-sm font-semibold text-sun">The GHL Megaminds way</p>
        </div>
        <h3 class="mt-6 text-[1.85rem] font-extrabold leading-[1.08] tracking-[-0.032em]">
          A certified team that works like your own.
        </h3>
        <ul class="mt-7 grid gap-3.5" data-stagger style="--d: 380">
          {
            megamindsPoints.map((point) => (
              <li class="flex gap-3 text-[16px] leading-snug text-canvas/90">
                <span class="mt-px grid size-6 shrink-0 place-items-center rounded-full bg-[#17c94b] text-ink">
                  <Icon name="check" class="size-3.5" />
                </span>
                {point}
              </li>
            ))
          }
        </ul>
        <a href={PLANS_HREF} class="link-arrow mt-auto self-start pt-9 decoration-canvas/30">
          {PLANS_LABEL}
          <Icon name="arrow-right" class="btn-arrow size-4" />
        </a>
      </div>
    </div>
  </div>
</section>
