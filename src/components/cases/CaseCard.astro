---
// Case study card: cover, who it was for, the story in one line and its three results. The title link stretches over
// the whole card, so the card is one click target.
import CaseCover from './CaseCover.astro';
import Icon from '../Icon.astro';
import type { CaseStudy } from '../../lib/cases';

interface Props {
  study: CaseStudy;
  /** Full-width horizontal card (cover left, text right on desktop). */
  wide?: boolean;
  /** Narrow three-up grids: smaller result figures so values like "30% → 11%" stay on one line. */
  compact?: boolean;
  class?: string;
  style?: string;
}

const { study, wide = false, compact = false, class: className, style } = Astro.props;
const { title, summary, kind, results } = study.data;
---

<article
  class:list={[
    'group relative flex flex-col overflow-hidden rounded-card bg-paper ring-1 ring-ink/[0.08] transition hover:-translate-y-1.5 hover:shadow-[0_28px_50px_-30px_color-mix(in_srgb,var(--color-ink)_40%,transparent)]',
    wide && 'lg:grid lg:grid-cols-2',
    className,
  ]}
  data-reveal="pop"
  style={style}
>
  <CaseCover study={study} size={wide ? 'wide' : 'card'} />

  <div class:list={['flex grow flex-col p-6 sm:p-8', wide && 'lg:justify-center lg:p-10']}>
    <p class="text-[13.5px] font-semibold text-forest">{kind}</p>
    <h3 class:list={['mt-2 font-extrabold leading-tight tracking-[-0.03em]', wide ? 'text-[1.7rem] sm:text-[2.1rem]' : 'text-[1.5rem] sm:text-[1.7rem]']}>
      <a href={`/case-studies/${study.id}/`} class="after:absolute after:inset-0 after:content-[''] focus-visible:outline-none">{title}</a>
    </h3>
    <p class="mt-3 leading-relaxed text-ink-soft">{summary}</p>

    <dl class="mt-7 grid grid-cols-3 gap-3 border-t border-ink/10 pt-6">
      {
        results.map((r) => (
          <div class="flex flex-col">
            <dt class="order-last mt-1.5 text-[12.5px] leading-snug text-ink-soft">{r.label}</dt>
            <dd class:list={['whitespace-nowrap font-display font-extrabold leading-none tracking-[-0.03em]', compact ? 'text-[1.05rem] lg:text-[1.12rem]' : 'text-[1.05rem] min-[440px]:text-[1.3rem] sm:text-[1.55rem]']}>{r.value}</dd>
          </div>
        ))
      }
    </dl>

    <p class="mt-7 inline-flex items-center gap-1.5 text-[15px] font-semibold text-ink" aria-hidden="true">
      Read the case study
      <Icon name="arrow-right" class="size-4 transition-transform group-hover:translate-x-1" />
    </p>
  </div>
</article>
