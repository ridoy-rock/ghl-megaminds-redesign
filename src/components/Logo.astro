---
// Horizontal lockup: the "Workflow" mark (three automation steps on a rising line) + "GHL Megaminds" in Satoshi
// ("GHL" Bold, "Megaminds" Black), outlined from the logo kit (scripts/logo-kit.mjs). The line and the name use the
// current text colour, so the logo follows the light/dark theme; the three dots keep their colours.
import LogoMark from './LogoMark.astro';

interface Props {
  tone?: 'ink' | 'light';
  class?: string;
}

const { tone = 'ink', class: className = 'w-[220px] sm:w-[240px]' } = Astro.props;
const color = tone === 'ink' ? 'text-ink' : 'text-canvas';
