---
import { pageHref, themeOf } from '../lib/theme';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { footerColumns, BOOK_HREF, BOOK_LABEL, DISCOVERY_HREF } from '../data/site';

const year = new Date().getFullYear();
// /v2 keeps its fixed blue theme (no theme switch) and books on its own embedded calendar.
const blue = themeOf(Astro.url) === 'blue';
const themes = [
  { value: 'system', label: 'System', path: 'M4 5h16v11H4zM9 20h6M12 16v4' },
  {
    value: 'light',
    label: 'Light',
    path: 'M12 3v2M12 19v2M5 12H3M21 12h-2M6.3 6.3 4.9 4.9M19.1 19.1l-1.4-1.4M6.3 17.7l-1.4 1.4M19.1 4.9l-1.4 1.4M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8z',
  },
  { value: 'dark', label: 'Dark', path: 'M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z' },
];
---

<footer class="relative overflow-hidden bg-canvas">
  <div class="container-x pt-16 lg:pt-24">
    <div class="grid gap-12 sm:grid-cols-3 lg:grid-cols-[1.4fr_1fr_1fr_1fr] lg:gap-16">
      <div class="flex flex-col items-start gap-5 sm:col-span-3 lg:col-span-1">
        <Logo />
        <p class="max-w-sm text-[15px] leading-relaxed text-muted">
          White-label HighLevel support by certified admins and software engineers.
        </p>
        <a href={blue ? BOOK_HREF : DISCOVERY_HREF} class="btn btn-ink mt-1">
          {BOOK_LABEL}
          <Icon name="arrow-right" class="btn-arrow size-4" />
        </a>
      </div>
      {
        footerColumns.map((column) => (
          <nav aria-label={column.title} class="flex flex-col gap-3.5 text-[15px]">
            <p class="text-xs font-semibold uppercase tracking-widest text-muted">{column.title}</p>
            {column.links.map((link) => (
              <a href={pageHref(link.href, Astro.url)} class="self-start text-ink/85 transition hover:text-ink">
                {link.label}
              </a>
            ))}
          </nav>
        ))
      }
    </div>

    <div class="mt-14 flex flex-col-reverse items-start justify-between gap-4 border-t border-hair py-6 text-[13px] text-muted sm:flex-row sm:items-center">
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
        <p>&copy; {year} GHL Megaminds. All rights reserved.</p>
        <a href="/privacy" class="transition hover:text-ink">Privacy Policy</a>
        <a href="/terms" class="transition hover:text-ink">Terms of Service</a>
      </div>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-4">
        {
          !blue && (
            <div class="theme-switch inline-flex items-center gap-1 rounded-full border border-hair bg-tint/[0.03] p-1" role="radiogroup" aria-label="Colour theme">
              {themes.map((theme) => (
                <button
                  type="button"
                  role="radio"
                  aria-checked={theme.value === 'system' ? 'true' : 'false'}
                  data-theme-option={theme.value}
                  class="inline-flex h-8 items-center gap-1.5 rounded-full px-3 text-[13px] font-medium text-muted transition hover:text-ink aria-checked:bg-card aria-checked:text-ink aria-checked:shadow-sm aria-checked:ring-1 aria-checked:ring-hair"
                >
                  <svg viewBox="0 0 24 24" class="size-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d={theme.path} />
                  </svg>
                  {theme.label}
                </button>
              ))}
            </div>
          )
        }
        <a href="#" class="inline-flex items-center gap-1.5 transition hover:text-ink">
          Back to top
          <svg viewBox="0 0 24 24" class="size-3.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 19V5M6 11l6-6 6 6" />
          </svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Full-width wordmark that drifts right to left forever (two identical halves make the loop seamless). Set in
       Satoshi Black, like the logo. -->
  <div class="wordmark-rise mt-10 select-none overflow-hidden" aria-hidden="true">
    <div class="wordmark-track flex w-max">
      {
        [0, 1].map(() => (
          <div class="flex shrink-0 items-center">
            {[0, 1, 2].map(() => (
              <span class="flex items-center whitespace-nowrap pb-[0.08em] font-display text-[clamp(4rem,12vw,11rem)] font-black leading-[0.95] tracking-[-0.045em] text-ink/[0.08]">
                GHL Megaminds
                <Icon name="sparkle-fill" class="mx-[0.3em] size-[0.42em] shrink-0" />
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</footer>

<script>
  // Theme switch: the choice is stored and applied by window.setTheme (Base.astro); keep aria-checked in sync.
  const options = document.querySelectorAll<HTMLButtonElement>('[data-theme-option]');
  const sync = () => {
    const pref = document.documentElement.dataset.themePref ?? 'system';
    options.forEach((option) => option.setAttribute('aria-checked', String(option.dataset.themeOption === pref)));
  };
  options.forEach((option) =>
    option.addEventListener('click', () => (window as unknown as { setTheme: (p: string) => void }).setTheme(option.dataset.themeOption ?? 'system')),
  );
  new MutationObserver(sync).observe(document.documentElement, { attributeFilter: ['data-theme-pref'] });
  sync();
</script>
