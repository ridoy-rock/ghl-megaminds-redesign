---
import { pageHref } from '../lib/theme';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { footerColumns, socials, SUBSCRIBE_URL, SUBSCRIBE_DUMMY } from '../data/site';

interface Props {
  /** Dark navy footer (the /v2 page). */
  dark?: boolean;
}

const { dark = false } = Astro.props;
const year = new Date().getFullYear();
// Colour sets for the light (default) and dark footer.
const c = dark
  ? { soft: 'text-canvas/65', hover: 'hover:text-canvas', line: 'border-canvas/10', field: 'bg-canvas/[0.06] ring-canvas/15 focus-within:ring-canvas/40', input: 'text-canvas placeholder:text-canvas/40', mark: 'text-canvas/[0.06]', social: 'text-canvas/70 ring-canvas/15 hover:bg-canvas hover:text-ink hover:ring-canvas' }
  : { soft: 'text-ink-soft', hover: 'hover:text-ink', line: 'border-ink/10', field: 'bg-paper ring-ink/10 focus-within:ring-ink/40', input: 'placeholder:text-ink-soft/70', mark: 'text-ink/[0.07]', social: 'text-ink/70 ring-ink/10 hover:bg-ink hover:text-canvas hover:ring-ink' };
// Dummy social links only show locally and on review builds, never on the live site.
const reviewBuild = import.meta.env.PUBLIC_REVIEW_BUILD === 'true';
const socialLinks = socials.filter((s) => (s.href && !s.dummy) || import.meta.env.DEV || reviewBuild);
if (import.meta.env.PROD && !reviewBuild && (!SUBSCRIBE_URL || SUBSCRIBE_DUMMY)) {
  console.warn('[footer] SUBSCRIBE_URL is a dummy: the newsletter form will not collect sign-ups.');
}
---

<footer class:list={['overflow-hidden pb-10 pt-20 lg:pt-24', dark && 'on-dark mt-6 bg-pine text-canvas']}>
  <div class="container-x">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-4">
        <Logo tone={dark ? 'light' : 'ink'} />
        <p class:list={['mt-5 max-w-[21rem] leading-relaxed', c.soft]}>
          White-label HighLevel support by certified admins and software engineers.
        </p>
        <form class="mt-8 max-w-[25rem]" data-subscribe data-endpoint={SUBSCRIBE_URL}>
          <!-- Visually hidden: the field still needs a name for screen readers. -->
          <label for="footer-email" class="sr-only">Get HighLevel tips in your inbox</label>
          <div class:list={['flex items-center gap-1.5 rounded-full p-1.5 ring-1 transition-shadow focus-within:ring-2', c.field]}>
            <input
              id="footer-email"
              name="email"
              type="email"
              required
              autocomplete="email"
              placeholder="you@agency.com"
              class:list={['h-11 min-w-0 flex-1 bg-transparent pl-4 text-[15px] outline-none', c.input]}
            />
            <button type="submit" class="btn btn-ink h-11 shrink-0 px-5 text-[15px]">Subscribe</button>
          </div>
          <p class:list={['mt-3 flex items-center gap-1.5 text-[13px]', c.soft]} aria-live="polite" data-subscribe-note>
            No spam. Unsubscribe anytime.
          </p>
        </form>
      </div>

      <div class="grid grid-cols-2 gap-x-8 gap-y-10 sm:grid-cols-3 lg:col-span-8">
        {
          footerColumns.map((column) => (
            <nav aria-label={column.title}>
              <p class="text-sm font-bold">{column.title}</p>
              <ul class="mt-4 grid gap-2.5">
                {column.links.map((link) => (
                  <li>
                    <a href={pageHref(link.href, Astro.url)} class:list={['text-[15px] transition', c.soft, c.hover]}>
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          ))
        }
      </div>
    </div>

  </div>

  <!-- Full-width wordmark that drifts right to left forever (two identical halves make the loop seamless) -->
  <div class="wordmark-rise mt-16 select-none overflow-hidden" aria-hidden="true">
    <div class="wordmark-track flex">
      {
        [0, 1].map(() => (
          <div class="flex shrink-0 items-center">
            {[0, 1, 2].map(() => (
              <span class={`flex items-center whitespace-nowrap pb-[0.08em] font-brand text-[clamp(4rem,12vw,11rem)] font-extrabold leading-[0.95] tracking-[-0.055em] ${c.mark}`}>
                GHL Megaminds
                <Icon name="sparkle-fill" class="mx-[0.3em] size-[0.42em] shrink-0" />
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <div class="container-x">
    <div
      class:list={['mt-6 flex flex-col gap-5 border-t pt-8 text-sm lg:grid lg:grid-cols-[1fr_auto_1fr] lg:items-center lg:gap-6', c.line, c.soft]}
    >
      <p>&copy; {year} GHL Megaminds. All rights reserved.</p>
      {
        socialLinks.length > 0 && (
          <ul class="flex gap-2" aria-label="GHL Megaminds on social media">
            {socialLinks.map((s) => (
              <li>
                <a
                  href={s.href || undefined}
                  target={s.href ? '_blank' : undefined}
                  rel={s.href ? 'noopener' : undefined}
                  aria-label={s.label}
                  class:list={['grid size-10 place-items-center rounded-full ring-1 transition', c.social]}
                >
                  <Icon name={s.icon} class="size-[18px]" />
                </a>
              </li>
            ))}
          </ul>
        )
      }
      <div class="flex gap-6 lg:justify-self-end">
        <a href="/privacy" class:list={['transition', c.hover]}>Privacy Policy</a>
        <a href="/terms" class:list={['transition', c.hover]}>Terms of Service</a>
      </div>
    </div>
  </div>
</footer>

<script>
  // Newsletter form: POST the email to the configured endpoint (form-encoded, so no CORS preflight), then thank them.
  const form = document.querySelector<HTMLFormElement>('[data-subscribe]');
  const note = form?.querySelector<HTMLElement>('[data-subscribe-note]');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  if (form && note && button) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const email = String(new FormData(form).get('email') ?? '').trim();
      const endpoint = form.dataset.endpoint;
      button.disabled = true;
      try {
        if (endpoint) {
          await fetch(endpoint, {
            method: 'POST',
            mode: 'no-cors',
            body: new URLSearchParams({ email, source: 'Website footer' }),
          });
        }
        note.textContent = "Thanks! You're on the list.";
        note.classList.add('font-semibold', 'text-forest');
        form.reset();
      } catch {
        note.textContent = 'Something went wrong. Please try again.';
      } finally {
        button.disabled = false;
      }
    });
  }
</script>
