---
// Small pill label that sits above a section title.
import Icon from './Icon.astro';

interface Props {
  icon?: string;
  tone?: 'light' | 'dark' | 'sun';
  class?: string;
  style?: string;
}

const { icon = 'sparkle-fill', tone = 'light', class: className, style } = Astro.props;

const pill = {
  light: 'bg-paper text-forest ring-1 ring-ink/10',
  dark: 'bg-canvas/[0.07] text-canvas ring-1 ring-canvas/15',
  sun: 'bg-sun text-on-brand',
};
const iconColor = { light: 'text-forest', dark: 'text-sun', sun: 'text-on-brand' };
---

<p
  class:list={[
    'inline-flex max-w-full items-center gap-2 rounded-full px-4 py-2 text-[12.5px] font-bold uppercase leading-snug tracking-[0.08em]',
    pill[tone],
    className,
  ]}
  style={style}
>
  <Icon name={icon} class:list={['size-3.5 shrink-0', iconColor[tone]]} />
  <span><slot /></span>
</p>
