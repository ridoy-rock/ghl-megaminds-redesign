---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import AppIcon from './AppIcon.astro';
import Eyebrow from './Eyebrow.astro';
import brokenArt from '../assets/crm/broken-workflow.png';
import { usualOptions, megamindsPoints, PLANS_HREF } from '../data/site';
---

<section id="why-us" class="scroll-mt-20 px-2 pt-20 sm:px-4 lg:pt-28">
  <div class="on-dark relative overflow-hidden rounded-[2rem] bg-pine text-canvas">
    <div
      class="pointer-events-none absolute -right-40 -top-40 size-[34rem] rounded-full border-[56px] border-canvas/[0.035]"
      aria-hidden="true"
    >
    </div>

    <div class="container-x relative py-20 lg:py-28">
      <div class="grid items-center gap-10 lg:grid-cols-12">
        <div class="lg:col-span-7" data-stagger>
          <Eyebrow tone="dark" icon="warning-circle-fill">The problem</Eyebrow>
          <h2 class="mt-5 text-[clamp(2.1rem,4.4vw,3.6rem)] font-extrabold leading-[1.02] tracking-[-0.038em]">
            Stop wasting time babysitting VAs or wrestling with complex tech.
          </h2>
          <p class="mt-6 max-w-[36rem] text-lg leading-relaxed text-canvas/70">
            You started your agency to build a scalable business, acquire high-ticket clients, and generate revenue.
            You did not start it to spend hours fixing broken workflows or micro-managing inexperienced virtual
            assistants.
          </p>
        </div>
        <div class="flex justify-center lg:col-span-5" data-reveal="scale" style="--d: 150">
          <!-- The broken workflow tilts as it passes through the viewport -->
          <div class="scroll-tilt" style="--tilt: 9deg">
          <Image
            src={brokenArt}
            alt="Clay illustration of a broken automation workflow with toppling app tiles and tangled cables"
            widths={[200, 300, 420]}
            sizes="(min-width: 1024px) 220px, 190px"
            class="float-soft h-auto w-[190px] lg:w-[220px]"
          />
          </div>
        </div>
      </div>

      <div class="mt-16 grid gap-6 lg:grid-cols-12 lg:gap-5">
        <div class="lg:col-span-6">
          <p class="mb-4 text-sm font-semibold text-canvas/60">The usual options</p>
          <ul class="grid gap-3">
            {
              usualOptions.map((option, i) => (
                <li
                  class="rounded-card bg-pine-raised p-6 ring-1 ring-canvas/10 sm:p-7"
                  data-reveal="left"
                  style={`--d: ${i * 90}`}
                >
                  <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2">
                    <h3 class="flex items-center gap-2.5 text-lg font-bold tracking-[-0.015em]">
                      <Icon name="x-circle-fill" class="size-5 shrink-0 text-canvas/35" />
                      {option.title}
                    </h3>
                    <span class="rounded-full bg-canvas/[0.08] px-3 py-1 text-xs font-semibold text-canvas/75">
                      {option.tag}
                    </span>
                  </div>
                  <p class="mt-2.5 text-[15.5px] leading-relaxed text-canvas/65">{option.body}</p>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="flex flex-col lg:col-span-6">
          <p class="mb-4 text-sm font-semibold text-sun">GHL Megaminds</p>
          <div class="grow rounded-card bg-canvas p-7 text-ink sm:p-9 lg:p-10" data-reveal="right" style="--d: 120">
            <AppIcon class="size-11" />
            <h3 class="mt-6 text-[1.85rem] font-extrabold leading-[1.08] tracking-[-0.032em]">
              A certified team that works like your own.
            </h3>
            <ul class="mt-7 grid gap-3.5" data-stagger style="--d: 380">
              {
                megamindsPoints.map((point) => (
                  <li class="flex gap-3 text-[16px] leading-snug">
                    <span class="mt-px grid size-6 shrink-0 place-items-center rounded-full bg-sun">
                      <Icon name="check" class="size-3.5" />
                    </span>
                    {point}
                  </li>
                ))
              }
            </ul>
            <a href={PLANS_HREF} class="link-arrow mt-9">
              See what's included
              <Icon name="arrow-right" class="btn-arrow size-4" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
