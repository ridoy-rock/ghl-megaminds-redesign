---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import AppIcon from './AppIcon.astro';
import Eyebrow from './Eyebrow.astro';
import towerArt from '../assets/illustrations/tower.png';
import { art } from '../lib/theme';
import { workflowSteps } from '../data/site';
---

<section class="py-24 lg:py-32">
  <div class="container-x">
    <div class="mx-auto max-w-[48rem] text-center" data-stagger>
      <Eyebrow icon="lightbulb-filament-fill">The solution</Eyebrow>
      <h2 class="mt-5 text-[clamp(2.1rem,4.4vw,3.6rem)] font-extrabold leading-[1.02] tracking-[-0.038em]">
        White-label HighLevel support by certified admins and engineers.
      </h2>
      <p class="mx-auto mt-6 max-w-[40rem] text-lg leading-relaxed text-ink-soft">
        We spent 10+ years building software, web applications and custom platforms for global businesses. Now we
        bring that engineering exclusively to the HighLevel ecosystem.
      </p>
    </div>

    <div class="mt-14 grid gap-4 lg:grid-cols-6 lg:gap-5">
      <!-- Engineering -->
      <article class="rounded-card bg-paper p-7 ring-1 ring-ink/[0.08] hover:-translate-y-1.5 hover:shadow-[0_28px_50px_-30px_color-mix(in_srgb,var(--color-ink)_40%,transparent)] sm:p-9 lg:col-span-4" data-reveal="pop">
        <h3 class="text-[1.6rem] font-bold leading-tight tracking-[-0.025em]">
          Certified admins and engineers, zero babysitting
        </h3>
        <p class="mt-3 max-w-[36rem] text-ink-soft">
          VAs struggle with complex workflows and native limits. Our certified team builds advanced logic, webhooks
          and APIs on its own.
        </p>

        <div class="mt-8 rounded-inner bg-canvas p-4 ring-1 ring-ink/[0.08] sm:p-5">
          <div class="mb-4 flex items-center justify-between gap-3 text-[13px]">
            <span class="font-semibold">Custom workflow</span>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-sage px-2.5 py-1 font-semibold text-forest">
              <span class="size-1.5 rounded-full bg-leaf"></span>
              Live
            </span>
          </div>
          <ol class="grid gap-2.5 sm:grid-cols-4 sm:gap-3">
            {
              workflowSteps.map((step, i) => (
                <li
                  class="node-run flex items-center gap-3 rounded-[12px] bg-paper p-3 ring-1 ring-ink/10 sm:flex-col sm:items-start sm:gap-4 sm:p-4"
                  style={`--i: ${i}`}
                >
                  <span class="grid size-9 shrink-0 place-items-center rounded-full bg-ink text-canvas">
                    <Icon name={step.icon} class="size-[18px]" />
                  </span>
                  <span class="text-[14.5px] font-semibold leading-snug">
                    <span class="sr-only">Step {i + 1}: </span>
                    {step.label}
                  </span>
                </li>
              ))
            }
          </ol>
        </div>
      </article>

      <!-- Pricing -->
      <article class="flex flex-col rounded-card bg-butter p-7 hover:-translate-y-1.5 hover:shadow-[0_28px_50px_-30px_color-mix(in_srgb,var(--color-ink)_40%,transparent)] sm:p-9 lg:col-span-2" data-reveal="pop" style="--d: 120">
        <h3 class="text-[1.6rem] font-bold leading-tight tracking-[-0.025em]">Fraction of the cost, zero overhead</h3>
        <p class="mt-3 text-ink/75">
          No salaries, recruiting delays or payroll taxes. An entire engineering squad on one flat monthly retainer.
        </p>
        <p class="mt-auto pt-10 font-display text-[2.6rem] font-extrabold leading-none tracking-[-0.045em]">
          $600-$1,200<span class="ml-1 text-lg font-bold tracking-normal text-ink/60">/mo</span>
        </p>
      </article>

      <!-- Partnership -->
      <article class="flex flex-col rounded-card bg-sage p-7 hover:-translate-y-1.5 hover:shadow-[0_28px_50px_-30px_color-mix(in_srgb,var(--color-ink)_40%,transparent)] sm:p-9 lg:col-span-2" data-reveal="pop">
        <h3 class="text-[1.6rem] font-bold leading-tight tracking-[-0.025em]">Boutique attention and VIP priority</h3>
        <p class="mt-3 text-ink/75">
          Large white-label shops bury you in ticket queues. We cap client intake, so you get fast turnarounds and
          direct partner access.
        </p>
        <div class="mt-auto pt-8">
          <!-- The message pops in like a fresh notification once the card is on screen -->
          <div class="rounded-inner bg-paper p-4 shadow-[0_14px_30px_-14px_color-mix(in_srgb,var(--color-forest)_45%,transparent)]" data-reveal="pop" style="--d: 500">
            <div class="flex items-start gap-3">
              <AppIcon class="size-9 shrink-0" />
              <div class="min-w-0">
                <p class="flex items-baseline justify-between gap-2 text-[13px]">
                  <span class="truncate font-semibold">#client-support</span>
                  <span class="shrink-0 text-ink-soft">just now</span>
                </p>
                <p class="mt-1 text-[14.5px] leading-snug">
                  Fixed the broken trigger and re-ran the workflow for all 42 contacts.
                </p>
              </div>
            </div>
          </div>
        </div>
      </article>

      <!-- White-label -->
      <article
        class="group grid overflow-hidden rounded-card bg-paper ring-1 ring-ink/[0.08] hover:-translate-y-1.5 hover:shadow-[0_28px_50px_-30px_color-mix(in_srgb,var(--color-ink)_40%,transparent)] sm:grid-cols-[1fr_auto] lg:col-span-4"
        data-reveal="pop"
        style="--d: 120"
      >
        <div class="p-7 sm:p-9">
          <h3 class="text-[1.6rem] font-bold leading-tight tracking-[-0.025em]">Delivered under your brand</h3>
          <p class="mt-3 max-w-[30rem] text-ink-soft">
            Clients see your agency, never us. We work inside your Slack, Teams or ticketing tool, under your name.
          </p>
          <ul class="mt-7 flex flex-wrap gap-2">
            {
              ['Your brand', 'Your Slack or Teams', 'Your ticketing tool'].map((item) => (
                <li class="inline-flex items-center gap-1.5 rounded-full bg-canvas px-3 py-1.5 text-sm font-semibold ring-1 ring-ink/10">
                  <Icon name="check" class="size-3.5 text-leaf" />
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
        <div class="flex items-center justify-center bg-stone/60 px-10 py-8 sm:w-[220px] sm:px-6 lg:w-[250px]">
          <Image
            src={art(towerArt, Astro.url)}
            alt="Clay illustration of a neat tower of rounded blocks with a golden block placed on top"
            widths={[180, 270, 360]}
            sizes="140px"
            class="h-auto w-[120px] transition-[translate] duration-500 ease-out-soft group-hover:-translate-y-1.5 sm:w-[130px]"
          />
        </div>
      </article>
    </div>
  </div>
</section>
