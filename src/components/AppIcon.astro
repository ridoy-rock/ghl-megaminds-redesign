---
// App-icon version of the mark (the rising dots on a pine rounded tile): avatars and the favicon.
// tone="light" puts the dots on a canvas tile for dark backgrounds. The tile follows the page theme.
import LogoMark from './LogoMark.astro';

interface Props {
  tone?: 'pine' | 'light';
  class?: string;
}

const { tone = 'pine', class: className } = Astro.props;
---

<span class:list={['relative inline-block overflow-hidden rounded-[25%]', tone === 'pine' ? 'bg-pine' : 'bg-canvas', className]} aria-hidden="true">
  <LogoMark class="absolute inset-[14%] size-[72%]" />
</span>
